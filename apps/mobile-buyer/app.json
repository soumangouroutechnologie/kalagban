{
  "expo": {
    "name": "Kalagban Client",
    "slug": "mobile-buyer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobilebuyer",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kalagban.mobilebuyer"
    },
    "android": {
      "package": "com.kalagban.mobilebuyer"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8FF",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#16a34a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "soumangouroutechnologie",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0c107dca-a4d2-44d2-8930-288d6a9872f0"
      }
    }
  }
}
